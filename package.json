{
  "name": "jiaru-personal-space",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "check:pages": "node scripts/check-pages.mjs",
    "build:pages": "npm run build && npm run check:pages",
    "preview:pages": "wrangler pages dev dist --ip 127.0.0.1 --port 8788"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "pinyin-pro": "^3.29.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.3",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "wrangler": "^4.137.0"
  }
}
